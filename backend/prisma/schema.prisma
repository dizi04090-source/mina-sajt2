generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  passwordHash  String
  avatarUrl     String?
  walletRsd     Int            @default(0)
  createdAt     DateTime       @default(now())
  bookings      Booking[]
  notifications Notification[]
}
model Category {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  treatments Treatment[]
}
model Treatment {
  id          String    @id @default(cuid())
  name        String
  description String?
  priceRsd    Int
  durationMin Int
  imageUrl    String?
  popular     Boolean   @default(false)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  bookings    Booking[]
}
model Booking {
  id          String        @id @default(cuid())
  userId      String
  treatmentId String
  startsAt    DateTime
  location    String        @default("Mina Wellness Salon, Bulevar Oslobođenja 123, Novi Sad")
  note        String?
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  treatment   Treatment     @relation(fields: [treatmentId], references: [id])
  @@index([userId])
  @@index([startsAt])
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
