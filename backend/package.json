{
  "name": "mina-backend",
  "private": true,
  "scripts": {
    "dev": "node src/server.js",
    "build": "prisma generate",
    "start": "prisma db push --skip-generate && ([ \"$AUTO_SEED\" = \"true\" ] && node prisma/seed.js || true) && node src/server.js",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}